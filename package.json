{
  "name": "maddox-training-os",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/run-with-build-info.mjs next dev",
    "build": "node scripts/run-with-build-info.mjs next build --webpack",
    "start": "next start",
    "start:lan": "next start --hostname 0.0.0.0 --port 3000",
    "ios:test": "npm run build && npm run start:lan",
    "vercel:build": "npm run build",
    "test": "vitest run",
    "qa:forward": "playwright test --config=playwright.forward.config.ts",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@openai/agents": "^0.14.0",
    "@supabase/supabase-js": "^2.108.1",
    "next": "^16.2.9",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^20.17.19",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.10",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vitest": "^4.1.9"
  }
}
